#!/bin/sh
#
# Blocks any commit that would leave the tree failing analysis or tests.
#
# The point is that "every commit is green" becomes a fact rather than an
# intention: `git bisect` is only useful if you can actually build and run
# each commit it lands on.
#
# Install (once per clone):
#     git config core.hooksPath tooling/git-hooks
#
# .git/hooks is not versioned, which is why this lives in the repo instead.
#
# Escape hatch: `git commit --no-verify`. Use it for a WIP commit on a
# throwaway branch, never on anything that reaches main.

set -e

# Only worth running when Dart or dependencies actually changed. A
# documentation-only commit should not pay for a test run.
if git diff --cached --name-only | grep -qE '\.dart$|^pubspec\.(yaml|lock)$'; then
    printf '\033[0;34m[pre-commit]\033[0m analysing...\n'
    if ! flutter analyze; then
        printf '\033[0;31m[pre-commit] flutter analyze failed. Commit aborted.\033[0m\n'
        exit 1
    fi

    printf '\033[0;34m[pre-commit]\033[0m running tests...\n'
    # --timeout guards against a hung widget test spinning for ten minutes and
    # looking like the hook itself has frozen.
    if ! flutter test --timeout 60s -r compact; then
        printf '\033[0;31m[pre-commit] tests failed. Commit aborted.\033[0m\n'
        exit 1
    fi

    printf '\033[0;32m[pre-commit] clean.\033[0m\n'
else
    printf '\033[0;34m[pre-commit]\033[0m no Dart changes, skipping analyze and tests.\n'
fi
